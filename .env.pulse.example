OMNI_EMAIL_SMTP_PASSWORD=
OMNI_EMAIL_SMTP_FROM_EMAIL=jimb@wakanow.com
OMNI_EMAIL_SMTP_USE_STARTTLS=true
OMNI_EMAIL_SMTP_USE_SSL=false
OMNI_EMAIL_SMTP_TIMEOUT_SECONDS=15
OMNI_EMAIL_IMAP_POLL_ENABLED=false
OMNI_EMAIL_IMAP_HOST=
