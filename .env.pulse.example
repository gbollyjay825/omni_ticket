PULSE_HTTP_PORT=80
PULSE_PUBLIC_ORIGIN=http://your-pulse-vm.example.com
PULSE_PUBLIC_API_BASE_URL=/api/v1
# Production support mailbox / sender identity: jimb@wakanow.com

PULSE_POSTGRES_DB=omni_ticket
PULSE_POSTGRES_USER=omni
PULSE_POSTGRES_PASSWORD=replace-with-a-strong-database-password

OMNI_APP_NAME="Omni Ticket Backend"
OMNI_ENVIRONMENT=pulse
OMNI_API_PREFIX=/api/v1
OMNI_DATABASE_ECHO=false
OMNI_INITIALIZE_DATABASE=true
OMNI_SESSION_SECRET=replace-with-a-long-random-session-secret
OMNI_SESSION_TTL_MINUTES=480
OMNI_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
OMNI_LOGIN_RATE_LIMIT_ATTEMPTS=10
OMNI_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
OMNI_CONNECTOR_INBOUND_RATE_LIMIT_ATTEMPTS=120
OMNI_CONNECTOR_INBOUND_RATE_LIMIT_WINDOW_SECONDS=60
OMNI_WEBHOOK_RATE_LIMIT_ATTEMPTS=120
OMNI_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
OMNI_ALLOWED_ORIGINS=["http://your-pulse-vm.example.com"]
OMNI_WORKER_INTERVAL_SECONDS=60
OMNI_WORKER_OUTBOUND_LIMIT=50
OMNI_ATTACHMENT_STORAGE_DIR=/var/lib/omni-ticket/attachments
OMNI_ATTACHMENT_MAX_BYTES=26214400
OMNI_ATTACHMENT_DOWNLOAD_TTL_MINUTES=10
OMNI_OUTBOUND_LOCAL_ADAPTER_ENABLED=true
OMNI_AI_PROVIDER=auto
OMNI_ANTHROPIC_API_KEY=
