OMNI_INITIALIZE_DATABASE=true
OMNI_DATABASE_POOL_SIZE=20
OMNI_DATABASE_MAX_OVERFLOW=20
OMNI_DATABASE_POOL_TIMEOUT_SECONDS=10
OMNI_DATABASE_POOL_RECYCLE_SECONDS=1800
OMNI_REDIS_URL=redis://127.0.0.1:6379/0
