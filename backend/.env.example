OMNI_SESSION_COOKIE_SECURE=false
OMNI_SESSION_COOKIE_SAMESITE=strict
OMNI_SESSION_COOKIE_DOMAIN=
OMNI_PASSWORD_LOGIN_MODE=all
OMNI_BREAK_GLASS_ADMIN_EMAILS=[]
