{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/|_/omni-ticket-backend/).*)",
      "destination": "/index.html"
    }
  ],
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "omni-ticket-backend": {
      "entrypoint": "backend/app/main.py",
      "routePrefix": "/_/omni-ticket-backend"
    }
  }
}
